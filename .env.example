# Copia este archivo como `.env` y rellena los valores reales.
# Las variables prefijadas con EXPO_PUBLIC_ se incluyen en el bundle JS
# (visibles para cualquiera que descompile la app — no metas secrets aquí).

# Sentry — Crash & error reporting.
# Crea un proyecto React Native en https://sentry.io (free tier: 5k errors/mes)
# y pega el DSN aquí. Si lo dejas vacío, Sentry no se inicializa.
EXPO_PUBLIC_SENTRY_DSN=
